# SPDX-License-Identifier: Apache-2.0

include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk

CROSSDEV :=

include $(TOPDIR)/arch/risc-v/src/common/Toolchain.defs

ARCHCPUFLAGS += --target=riscv32-unknown-elf

# Arch Linux ships the RISC-V compiler runtime with its GCC cross toolchain,
# while Clang supplies the compiler and linker.  Point Clang at that multilib
# installation so it can resolve compiler builtins such as 64-bit division.

RISCV_GCC_INSTALL_DIR := $(patsubst %/,%,$(dir $(shell riscv64-elf-gcc --print-file-name=crtbegin.o)))
ARCHCPUFLAGS += --gcc-install-dir=$(RISCV_GCC_INSTALL_DIR)
COMPILER_RT_LIB := $(shell riscv64-elf-gcc -march=rv32im -mabi=ilp32 --print-libgcc-file-name)
LD = ld.lld

ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)ld.script

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS += $(CFLAGS) -D__ASSEMBLY__
